{
  "save-token-context-cache": {
    "enabled": true,
    "SessionStart": [
      {
        "type": "command",
        "command": "node --no-warnings=ExperimentalWarning ./scripts/session-start-hook.mjs",
        "timeout": 5
      }
    ]
  },
  "save-token-pretool-guard": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command|read_file",
        "hooks": [
          {
            "type": "command",
            "command": "node --no-warnings=ExperimentalWarning ./scripts/pre-tool-guard-hook.mjs",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "save-token-idle-snapshot": {
    "enabled": true,
    "Stop": [
      {
        "type": "command",
        "command": "node --no-warnings=ExperimentalWarning ./scripts/stop-idle-snapshot-hook.mjs",
        "timeout": 6
      }
    ]
  }
}
